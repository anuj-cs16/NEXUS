# ============================================================
# NEXUS Monorepo .gitignore
# ============================================================

# --- Node.js / JavaScript ---
node_modules/
.pnpm-store/
.turbo/
.next/
out/
dist/
*.tsbuildinfo

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
.eggs/
.venv/
venv/
.uv/
*.db
*.db-journal
*.db-wal

# --- Rust / Tauri ---
target/
src-tauri/target/

# --- IDE ---
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# --- Environment ---
.env
.env.local
.env.*.local

# --- Logs ---
logs/
*.log
npm-debug.log*
pnpm-debug.log*

# --- Docker ---
docker-compose.override.yml

# --- Testing ---
coverage/
.coverage
htmlcov/
.pytest_cache/

# --- Build artifacts ---
*.exe
*.msi
*.apk
*.aab

# --- NEXUS runtime ---
.nexus/
nexus.db
nexus_backup_*.db
